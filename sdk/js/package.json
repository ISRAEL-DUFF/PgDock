{
  "name": "@xenibase/client",
  "version": "0.1.1",
  "description": "Xenibase's client: data, auth, storage and realtime for web, React Native and Node apps (ESM and CommonJS)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISRAEL-DUFF/Xenibase.git",
    "directory": "sdk/js"
  },
  "homepage": "https://github.com/ISRAEL-DUFF/Xenibase/tree/main/sdk/js#readme",
  "bugs": {
    "url": "https://github.com/ISRAEL-DUFF/Xenibase/issues"
  },
  "keywords": [
    "xenibase",
    "postgres",
    "database",
    "auth",
    "storage",
    "realtime",
    "client",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\\\n')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js"
}
