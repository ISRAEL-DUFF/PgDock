# pgdock-server settings for the dev environment (deploy/dev/compose.yaml).
# Used by `make dev`, `make run-dev`, and the integration tests. Local
# development only.
PGDOCK_DATABASE_URL=postgres://pgdock:pgdock@127.0.0.1:5440/pgdock?sslmode=disable
PGDOCK_MASTER_KEY_FILE=tmp/dev-master.key
PGDOCK_DEV_ENDPOINTS=true
PGDOCK_LOG_FORMAT=text

# The shared cluster, as pgdock-server reaches it (published port) and as
# the poolers reach it (Compose network).
PGDOCK_SHARED_ADMIN_URL=postgres://pgdock_admin:pgdock_admin@127.0.0.1:5441/postgres?sslmode=disable
PGDOCK_SHARED_POOLER_HOST=shared-pg
PGDOCK_SHARED_POOLER_PORT=5432

# Generated pooler files land in tmp/pooler, mounted into both PgBouncers.
PGDOCK_POOLER_CONFIG_DIR=tmp/pooler
PGDOCK_POOLER_FILE_MODE=644
PGDOCK_POOLER_ADMIN_PASSWORD=pgdock
PGDOCK_POOLER_SSLMODE=require
# Self-signed until you set a real DB hostname (then try acme).
PGDOCK_POOLER_TLS=self-signed
PGDOCK_DATA_DIR=tmp/data
# Plain HTTP in dev, so cookies cannot be Secure.
PGDOCK_COOKIE_SECURE=false

# What clients get in their connection strings.
PGDOCK_DB_HOST=127.0.0.1
PGDOCK_DB_SESSION_PORT=6432
PGDOCK_DB_POOLED_PORT=6543
PGDOCK_DB_SSLMODE=require
