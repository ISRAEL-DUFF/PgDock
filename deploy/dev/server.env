# xenibase-server settings for the dev environment (deploy/dev/compose.yaml).
# Used by `make dev`, `make run-dev`, and the integration tests. Local
# development only.
XENIBASE_DATABASE_URL=postgres://xenibase:xenibase@127.0.0.1:5440/xenibase?sslmode=disable
XENIBASE_MASTER_KEY_FILE=tmp/dev-master.key
XENIBASE_DEV_ENDPOINTS=true
XENIBASE_LOG_FORMAT=text

# The shared cluster, as xenibase-server reaches it (published port) and as
# the poolers reach it (Compose network).
XENIBASE_SHARED_ADMIN_URL=postgres://xenibase_admin:xenibase_admin@127.0.0.1:5441/postgres?sslmode=disable
XENIBASE_SHARED_POOLER_HOST=shared-pg
XENIBASE_SHARED_POOLER_PORT=5432

# Generated pooler files land in tmp/pooler, mounted into both PgBouncers.
XENIBASE_POOLER_CONFIG_DIR=tmp/pooler
XENIBASE_POOLER_FILE_MODE=644
XENIBASE_POOLER_ADMIN_PASSWORD=xenibase
XENIBASE_POOLER_SSLMODE=require
# Self-signed until you set a real DB hostname (then try acme).
XENIBASE_POOLER_TLS=self-signed
XENIBASE_DATA_DIR=tmp/data
# Plain HTTP in dev, so cookies cannot be Secure.
XENIBASE_COOKIE_SECURE=false

# What clients get in their connection strings.
XENIBASE_DB_HOST=127.0.0.1
XENIBASE_DB_SESSION_PORT=6432
XENIBASE_DB_POOLED_PORT=6543
XENIBASE_DB_SSLMODE=require
