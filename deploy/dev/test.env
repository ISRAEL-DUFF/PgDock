# Environment for test/integration and test/isolation (see test/testenv),
# against `make dev-up` plus the test pooler pair (`--profile test`).
PGDOCK_TEST_DATABASE_URL=postgres://pgdock:pgdock@127.0.0.1:5440/pgdock?sslmode=disable
PGDOCK_TEST_SHARED_ADMIN_URL=postgres://pgdock_admin:pgdock_admin@127.0.0.1:5441/postgres?sslmode=disable
PGDOCK_TEST_SHARED_POOLER_HOST=shared-pg
PGDOCK_TEST_SHARED_POOLER_PORT=5432
PGDOCK_TEST_POOLER_DIR=tmp/pooler-test
PGDOCK_TEST_POOLER_SESSION_ADDR=127.0.0.1:6442
PGDOCK_TEST_POOLER_POOLED_ADDR=127.0.0.1:6553
PGDOCK_TEST_POOLER_ADMIN_PASSWORD=pgdock
# M3: the agent container, the address host-side test servers listen on
# (the Compose network's gateway), and the import sources.
PGDOCK_TEST_DOCKER_GATEWAY=172.31.251.1
PGDOCK_TEST_AGENT_CONTAINER=pgdock-dev-agent-test-1
PGDOCK_TEST_AGENT_ADDR=127.0.0.1:7071
PGDOCK_TEST_METADATA_AGENT_HOST=metadata-db:5432
PGDOCK_TEST_SRC_SUPABASE_URL=postgres://postgres:supabase-source@172.31.251.1:5450/postgres?sslmode=disable
PGDOCK_TEST_SRC_PG15_URL=postgres://postgres:pg15-source@172.31.251.1:5451/postgres?sslmode=disable
# M4: dedicated instances, run by the agent through the host's Docker.
PGDOCK_TEST_PG_IMAGE=pgdock-postgres:{major}-walg3.0.9
PGDOCK_TEST_DOCKER_NETWORK=pgdock-dev_default
PGDOCK_TEST_AGENT2_CONTAINER=pgdock-dev-agent-test-2-1
PGDOCK_TEST_AGENT2_ADDR=127.0.0.1:7072
PGDOCK_TEST_AGENT3_CONTAINER=pgdock-dev-agent-test-3-1
PGDOCK_TEST_AGENT3_ADDR=127.0.0.1:7073
PGDOCK_TEST_AGENT4_CONTAINER=pgdock-dev-agent-test-4-1
PGDOCK_TEST_AGENT4_ADDR=127.0.0.1:7074
# M7: a shared cluster with a small data disk, for the disk-full test.
PGDOCK_TEST_SMALL_ADMIN_URL=postgres://pgdock_admin:pgdock_admin@127.0.0.1:5442/postgres?sslmode=disable
PGDOCK_TEST_SMALL_POOLER_HOST=shared-pg-small
PGDOCK_TEST_POOLER_TX_CONTAINER=pgdock-dev-pooler-tx-test-1
# The load test's second shared node (make test-load).
PGDOCK_TEST_LOAD2_ADMIN_URL=postgres://pgdock_admin:pgdock_admin@127.0.0.1:5443/postgres?sslmode=disable
PGDOCK_TEST_LOAD2_POOLER_HOST=shared-pg-2
# M17: the edge pooler host failover test (make pooler-host-images).
PGDOCK_TEST_POOLER_HOST_IMAGE=pgdock-pooler-host:local
PGDOCK_TEST_KEEPALIVED_IMAGE=pgdock-keepalived:local
PGDOCK_TEST_STATUS_IMAGE=pgdock-status:local
# V4-M36: a Supabase hobby project (Supabase's Postgres, GoTrue, storage-api
# with its S3 protocol) for the migration helper.
