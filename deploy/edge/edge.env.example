# pgdock-edge (V4 §2.1). Copy to edge.env on each edge node and edit.
# pgdock-server's URL as the edge reaches it (over the mesh is best).
PGDOCK_EDGE_CONTROL_URL=https://pgdock.internal:8080
# The same secret as pgdock-server's PGDOCK_EDGE_SECRET (32+ characters).
PGDOCK_EDGE_SECRET=
# Projects are served at https://<ref>.<domain>; the same as PGDOCK_API_DOMAIN.
PGDOCK_EDGE_DOMAIN=api.pgdock.ng
# The region this edge serves (empty: every region).
PGDOCK_EDGE_REGION=ng-lagos
# A wildcard certificate for *.<domain> (renewed by your DNS-01 client; the
# edge re-reads it). Leave both empty behind a TLS terminator.
PGDOCK_EDGE_TLS_CERT=/etc/pgdock-edge/tls/fullchain.pem
PGDOCK_EDGE_TLS_KEY=/etc/pgdock-edge/tls/privkey.pem
PGDOCK_EDGE_LISTEN=:443
# Optional: the transaction pooler as this edge reaches it (host:port), and
# the proxies allowed to set X-Forwarded-For (CIDRs, comma-separated).
#PGDOCK_EDGE_POOLER_ADDR=10.0.0.2:6543
#PGDOCK_EDGE_TRUSTED_PROXIES=10.0.0.0/16
