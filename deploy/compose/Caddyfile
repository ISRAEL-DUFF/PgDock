# TLS for the web UI (spec §3.2). Caddy obtains the UI certificate itself;
# xenibase-server obtains the DB hostname's certificate for the poolers, and
# Caddy forwards that hostname's HTTP-01 challenges to it.
{
	email {$XENIBASE_ACME_EMAIL}
	{$CADDY_GLOBAL_OPTIONS}
}

{$XENIBASE_UI_DOMAIN} {
	{$CADDY_UI_TLS}
	encode zstd gzip
	reverse_proxy xenibase-server:8080
}

# Backend services' wildcard API domain, written by enable-services.sh. Nothing
# matches (and nothing is served) until then.
import /etc/caddy/caddy.d/*.caddy

# Any other host on port 80: ACME challenges go to xenibase-server (for the
# DB hostname's certificate); everything else is sent to the UI.
http:// {
	handle /.well-known/acme-challenge/* {
		reverse_proxy xenibase-server:8080
	}
	handle {
		redir https://{$XENIBASE_UI_DOMAIN}{uri}
	}
}
