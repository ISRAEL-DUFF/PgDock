# Copy to .env (install.sh does this for you with generated secrets).
XENIBASE_UI_DOMAIN=xenibase.example.com
XENIBASE_ACME_EMAIL=you@example.com
# This host's public IPs, for the DB hostname DNS check.
XENIBASE_PUBLIC_IPS=
# Generate with: head -c 32 /dev/urandom | base64
XENIBASE_MASTER_KEY=
METADATA_DB_PASSWORD=
SHARED_ADMIN_PASSWORD=
POOLER_ADMIN_PASSWORD=
