# The load rig's settings (README.md). Copy to .env next to compose.yaml on
# each server; every server can share the same file.

# Private addresses (Hetzner network 10.0.0.0/16 by default).
PRIVATE_CIDR=10.0.0.0/16
NODE1_IP=10.0.0.2
EDGE_IP=10.0.0.6
# This server's own private address (node profile only).
NODE_IP=

# pgdock-server as agents, the edge and the load host reach it.
PGDOCK_SERVER_URL=https://pgdock.example.com
# The same values as on node-1's pgdock-server.
PGDOCK_API_DOMAIN=api.example.com
PGDOCK_EDGE_SECRET=

# Images (built with `make edge-image` and the agent image, then pushed).
PGDOCK_AGENT_IMAGE=
PGDOCK_EDGE_IMAGE=
#PGDOCK_PG_IMAGE=pgdock-postgres:{major}-walg3.0.9

# One-time token from Platform → Nodes → Add node (node profile only).
PGDOCK_AGENT_TOKEN=

# A platform admin of this throwaway install, for the load host.
PGDOCK_LOAD_EMAIL=
PGDOCK_LOAD_PASSWORD=
# The admin's TOTP secret (shown as text when enrolling).
PGDOCK_LOAD_TOTP_SECRET=
# The PEM the edge's certificate chains to, if self-signed (path inside the
# load container: the checkout is /src).
#PGDOCK_LOAD_EDGE_CA=/src/deploy/loadtest/tls/ca.pem

# The run.
PGDOCK_LOAD_BACKEND_PROJECTS=1000
PGDOCK_LOAD_RPS=2000
PGDOCK_LOAD_SECONDS=60
PGDOCK_LOAD_STEPS=500,1000,1500
PGDOCK_LOAD_TRANSFORMS=200
PGDOCK_LOAD_PARALLEL=16
