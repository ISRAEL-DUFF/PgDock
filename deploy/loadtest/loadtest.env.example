# The load rig's settings (README.md). Copy to .env next to compose.yaml on
# each server; every server can share the same file.

# Private addresses (Hetzner network 10.0.0.0/16 by default).
PRIVATE_CIDR=10.0.0.0/16
NODE1_IP=10.0.0.2
EDGE_IP=10.0.0.6
# This server's own private address (node profile only).
NODE_IP=

# xenibase-server as agents, the edge and the load host reach it.
XENIBASE_SERVER_URL=https://xenibase.example.com
# The same values as on node-1's xenibase-server.
XENIBASE_API_DOMAIN=api.example.com
XENIBASE_EDGE_SECRET=

# Images (built with `make edge-image` and the agent image, then pushed).
XENIBASE_AGENT_IMAGE=
XENIBASE_EDGE_IMAGE=
#XENIBASE_PG_IMAGE=xenibase-postgres:{major}-walg3.0.9

# One-time token from Platform → Nodes → Add node (node profile only).
XENIBASE_AGENT_TOKEN=

# A platform admin of this throwaway install, for the load host.
XENIBASE_LOAD_EMAIL=
XENIBASE_LOAD_PASSWORD=
# The admin's TOTP secret (shown as text when enrolling).
XENIBASE_LOAD_TOTP_SECRET=
# The PEM the edge's certificate chains to, if self-signed (path inside the
# load container: the checkout is /src).
#XENIBASE_LOAD_EDGE_CA=/src/deploy/loadtest/tls/ca.pem

# The run.
XENIBASE_LOAD_BACKEND_PROJECTS=1000
XENIBASE_LOAD_RPS=2000
XENIBASE_LOAD_SECONDS=60
XENIBASE_LOAD_STEPS=500,1000,1500
XENIBASE_LOAD_TRANSFORMS=200
XENIBASE_LOAD_PARALLEL=16
