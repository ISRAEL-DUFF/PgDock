# An in-memory S3 server, a catch-all SMTP server and a webhook receiver
# for the e2e bundle.
# Build from the repository root:
#   docker build -f test/e2e/bundle/Dockerfile.fakes3 -t pgdock-fakes3:local .
ARG REGISTRY=
FROM ${REGISTRY}golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=ca_bundle,required=false \
    if [ -f /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle; fi; \
    go mod download
COPY internal/ ./internal/
COPY test/e2e/fakes3/ ./test/e2e/fakes3/
COPY test/e2e/fakesmtp/ ./test/e2e/fakesmtp/
COPY test/e2e/fakehook/ ./test/e2e/fakehook/
RUN CGO_ENABLED=0 go build -trimpath -o /out/fakes3 ./test/e2e/fakes3 && \
    CGO_ENABLED=0 go build -trimpath -o /out/fakesmtp ./test/e2e/fakesmtp && \
    CGO_ENABLED=0 go build -trimpath -o /out/fakehook ./test/e2e/fakehook

FROM ${REGISTRY}alpine:3.22
COPY --from=build /out/fakes3 /out/fakesmtp /out/fakehook /usr/local/bin/
USER 65534
ENTRYPOINT ["/usr/local/bin/fakes3"]
